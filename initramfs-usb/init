#!/bin/busybox sh
# denniz first-boot initramfs (design reused from the epad "usb-wdt" initramfs).
# USB gadget 18d1:d001 = ECM (phone 172.16.42.1, MACs 02:00:00:d2:10:01/02) + ACM with a root shell on
# /dev/ttyGS0 (host: /dev/ttyACM0). Read-only: mounts nothing from UFS.
# Safety: reboot -f after $WAIT s (default 300) unless /tmp/keep exists -> LK boots Android normally.
# /tmp/switchroot (written by the host) switches into a rootfs unpacked in /newroot.
# Persistent mode: /pmos_root (or pmos_root=NAME) mounts that partition's btrfs subvolume @ as root instead.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || { mount -t tmpfs tmpfs /dev; mdev -s; }
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs none /sys/kernel/config
mount -t tmpfs tmpfs /tmp
mount -t debugfs none /sys/kernel/debug 2>/dev/null
log() { echo "DENNIZ: $*" > /dev/kmsg; }
log "initramfs up: $(uname -r)"
WAIT=$(sed -n 's/.*denniz.wait=\([0-9]*\).*/\1/p' /proc/cmdline); WAIT=${WAIT:-300}
( sleep $WAIT; [ -e /tmp/keep ] || { log "safety timer: reboot"; sync; reboot -f; } ) &
for f in panic_on_rcu_stall softlockup_panic hung_task_panic; do echo 1 > /proc/sys/kernel/$f; done 2>/dev/null
for i in $(seq 1 20); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 1; done
log "udc: $(ls /sys/class/udc 2>&1)"
G=/sys/kernel/config/usb_gadget/denniz
mkdir -p $G && cd $G
echo 0x18d1 > idVendor; echo 0xd001 > idProduct
mkdir -p strings/0x409
echo "OnePlus" > strings/0x409/manufacturer
echo "Nord 2 mainline initramfs" > strings/0x409/product
echo "denniz-initramfs" > strings/0x409/serialnumber
mkdir -p configs/c.1/strings/0x409
echo "ECM+ACM" > configs/c.1/strings/0x409/configuration
mkdir -p functions/ecm.usb0 functions/acm.gs0
echo 02:00:00:d2:10:01 > functions/ecm.usb0/dev_addr
echo 02:00:00:d2:10:02 > functions/ecm.usb0/host_addr
ln -s functions/ecm.usb0 configs/c.1/
ln -s functions/acm.gs0 configs/c.1/
ls /sys/class/udc | head -1 > UDC
log "gadget: UDC=$(cat UDC) state=$(cat /sys/class/udc/*/state 2>/dev/null)"
cd /
for i in $(seq 1 10); do [ -e /sys/class/net/usb0 ] && break; sleep 1; done
ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up && log "usb0 up"
( while true; do setsid sh -c "exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1"; sleep 1; done ) &
GS_LOOP=$!
log "shell on ttyGS0"
# RAM boot of a full rootfs without flashing (scripts/pmos-ram.sh): the host unpacks it into /newroot and writes
# the init path into /tmp/switchroot; then PID 1 (us) moves the mounts and switches. Gadget + usb0 IP stay.
# Persistent install: root partition name from /pmos_root (persistent initramfs) or pmos_root= on the cmdline;
# btrfs, subvolume @. Any failure keeps the RAM-boot path above alive (USB shell, no safety reboot).
PR=$(sed -n 's/.*pmos_root=\([^ ]*\).*/\1/p' /proc/cmdline); [ -z "$PR" ] && [ -r /pmos_root ] && PR=$(cat /pmos_root)
if [ -n "$PR" ] && [ "$PR" != none ]; then
  DEV=""
  for i in $(seq 1 15); do
    for u in /sys/class/block/*/uevent; do grep -qx "PARTNAME=$PR" $u && DEV=/dev/$(basename ${u%/uevent}); done
    [ -n "$DEV" ] && break; sleep 1
  done
  mkdir -p /newroot
  if [ -n "$DEV" ] && mount -t btrfs -o noatime,subvol=@ $DEV /newroot && [ -e /newroot/sbin/init ]; then
    log "persistent root: $PR = $DEV"; touch /tmp/keep; echo /sbin/init > /tmp/switchroot
  else
    umount /newroot 2>/dev/null; touch /tmp/keep
    log "persistent root $PR ($DEV) FAILED: staying in the initramfs, waiting for a RAM rootfs"
  fi
fi
while [ ! -e /tmp/switchroot ]; do sleep 2; done
log "switch_root to /newroot ($(cat /tmp/switchroot))"
for m in dev proc sys; do mkdir -p /newroot/$m; mount --move /$m /newroot/$m; done
# the ttyGS0 respawn loop must not outlive the initramfs: once its busybox is gone and the gadget is torn
# down (USB host mode for an OTG hub) it spins printing "sleep: not found" on the console
kill $GS_LOOP 2>/dev/null; pkill -f "exec sh </dev/ttyGS0" 2>/dev/null
exec switch_root /newroot $(cat /tmp/switchroot)
