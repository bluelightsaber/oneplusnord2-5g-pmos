From: bluelightsaber <bluelightsaber@users.noreply.github.com>
Date: Sat, 14 Nov 2026 22:29:31 +0100
Subject: [PATCH] denniz: OnePlus Nord 2 5G first-boot board tree and config

---
 arch/arm64/boot/dts/mediatek/Makefile         |    1 +
 .../dts/mediatek/mt6893-oneplus-denniz.dts    | 3536 +++++++++++++++++
 arch/arm64/configs/denniz_defconfig           | 1966 +++++++++
 arch/arm64/kernel/chopin-board.dts            |    2 +-
 arch/arm64/kernel/head.S                      |    4 +-
 drivers/misc/mtk-logstore-console.c           |    4 +-
 6 files changed, 5508 insertions(+), 5 deletions(-)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6893-oneplus-denniz.dts
 create mode 100644 arch/arm64/configs/denniz_defconfig

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index 819767ded..f1ac26377 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -2,6 +2,7 @@
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt2712-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6755-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6893-xiaomi-chopin.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6893-oneplus-denniz.dtb
 
 # Compile this board's DTB with symbols (-@), i.e. keep the __symbols__ node.
 #
diff --git a/arch/arm64/boot/dts/mediatek/mt6893-oneplus-denniz.dts b/arch/arm64/boot/dts/mediatek/mt6893-oneplus-denniz.dts
new file mode 100644
index 000000000..80488033f
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6893-oneplus-denniz.dts
@@ -0,0 +1,3536 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OnePlus Nord 2 5G (denniz) - generated from the chopin board file by scripts/mk-denniz-dts.py
+ *
+ * Board file: model, memory map and the wiring that is specific to this
+ * handset.  The SoC side lives in mt6893.dtsi.
+ */
+
+/dts-v1/;
+
+#include "mt6893.dtsi"
+
+/ {
+	model = "OnePlus Nord 2 5G (denniz)";
+	compatible = "oneplus,denniz", "mediatek,MT6893";
+	interrupt-parent = <&gic>;
+	#address-cells = <0x02>;
+	#size-cells = <0x02>;
+
+	bootprof {
+		lk_logo_t = <0x3ee>;
+		lk_t = <0xe29>;
+		pl_t = <0xaa4>;
+	};
+	md_attr_node {
+		mediatek,md_product_name_model_id = <0xf0f0f0f>;
+		mediatek,md_drdi_rf_set_idx = <0x0a>;
+		compatible = "mediatek,md_attr_node";
+	};
+	firmware {
+
+		android {
+			mode = "normal";
+			/* serialno removed: identify the device, not the board */
+			hardware = "mt6893";
+			compatible = "android,firmware";
+			vbmeta.hash_alg = "sha256";
+		};
+	};
+	mt6360_pmu: mt6360_pmu_dts {
+		status = "ok";
+		mt6360,intr_gpio_num = <0x18>;
+		mt6360,intr_gpio = <0x02 0x18 0x00>;
+		interrupt-controller;
+		#interrupt-cells = <0x02>;
+		phandle = <0x03>;
+
+		adc: adc {
+			compatible = "mediatek,mt6360_pmu_adc";
+			interrupt-parent = <&mt6360_pmu>;
+			interrupts = <0x29 0x00 0x2b 0x00 0x2c 0x00>;
+			interrupt-names = "bat_ovp_adc_evt", "adc_wakeup_evt", "adc_donei";
+			#io-channel-cells = <0x01>;
+			phandle = <0x04>;
+		};
+
+		chg {
+			compatible = "mediatek,mt6360_pmu_chg";
+			interrupt-parent = <&mt6360_pmu>;
+			interrupts = <0x04 0x00 0x06 0x00 0x07 0x00 0x09 0x00 0x0c 0x00 0x0d 0x00 0x0e 0x00 0x0f 0x00 0x1b 0x00 0x1d 0x00 0x20 0x00 0x23 0x00 0x28 0x00 0x30 0x00 0x3c 0x00>;
+			interrupt-names = "chg_treg_evt", "chg_mivr_evt", "pwr_rdy_evt", "chg_batsysuv_evt", "chg_vsysuv_evt", "chg_vsysov_evt", "chg_vbatov_evt", "chg_vbusov_evt", "chg_tmri", "chg_adpbadi", "chg_aiccmeasl", "wdtmri", "pumpx_donei", "attachi", "chrdet_ext_evt";
+			io-channels = <0x04 0x00 0x04 0x01 0x04 0x03 0x04 0x04 0x04 0x05 0x04 0x06 0x04 0x08 0x04 0x0a>;
+			io-channel-names = "USBID", "VBUSDIV5", "VSYS", "VBAT", "IBUS", "IBAT", "TEMP_JC", "TS";
+			chg_name = "primary_chg";
+			ichg = <0x1e8480>;
+			aicr = <0x7a120>;
+			mivr = <0x432380>;
+			cv = <0x43e6d0>;
+			ieoc = <0x30d40>;
+			safety_timer = <0x0c>;
+			ircmp_resistor = <0x00>;
+			ircmp_vclamp = <0x00>;
+			en_te = <0x01>;
+			en_wdt = <0x01>;
+			en_otg_wdt = <0x01>;
+			aicc_once = <0x01>;
+			post_aicc = <0x01>;
+			batoc_notify = <0x00>;
+			en_eoc = <0x01>;
+		};
+
+		fled {
+			compatible = "mediatek,mt6360_pmu_fled";
+			interrupt-parent = <&mt6360_pmu>;
+			interrupts = <0x0b 0x00 0x4a 0x00 0x4b 0x00 0x4e 0x00 0x4f 0x00>;
+			interrupt-names = "fled_chg_vinovp_evt", "fled_tx_evt", "fled_lvf_evt", "fled2_short_evt", "fled1_short_evt";
+			fled_vmid_track = <0x00>;
+			fled_strb_tout = <0x4e0>;
+			fled1_tor_cur = <0x927c>;
+			fled1_strb_cur = <0xb71b0>;
+			fled2_tor_cur = <0x927c>;
+			fled2_strb_cur = "", "\f5";
+		};
+
+		rgbled {
+			compatible = "mediatek,mt6360_pmu_rgbled";
+			mt,led_name = "red", "green", "blue", "mt6360_pmu_led4";
+			mt,led_default_trigger = "cc_mode", "cc_mode", "cc_mode", "none";
+		};
+
+		core {
+			compatible = "mediatek,mt6360_pmu_core";
+			interrupt-parent = <&mt6360_pmu>;
+			interrupts = <0x41 0x00 0x42 0x00 0x43 0x00 0x44 0x00 0x45 0x00 0x46 0x00 0x47 0x00>;
+			interrupt-names = "ap_wdtrst_evt", "en_evt", "qonb_rst_evt", "mrstb_evt", "otp_evt", "vddaov_evt", "sysuv_evt";
+			mren = <0x01>;
+			apwdtrst_en = <0x01>;
+			cc_open_sel = <0x03>;
+			i2c_cc_open_tsel = <0x01>;
+			ldo5_otp_en = <0x00>;
+			sda_sizesel = <0x03>;
+			sda_drvsrsel = <0x01>;
+		};
+	};
+	mt6360_pmic: mt6360_pmic_dts {
+		status = "ok";
+		interrupt-parent = <&mt6360_pmu>;
+		interrupts = <0x60 0x00 0x64 0x00 0x65 0x00 0x66 0x00 0x68 0x00 0x6c 0x00 0x6d 0x00 0x6e 0x00 0x76 0x00 0x77 0x00 0x7e 0x00 0x7f 0x00>;
+		interrupt-names = "buck1_pgb_evt", "buck1_oc_evt", "buck1_ov_evt", "buck1_uv_evt", "buck2_pgb_evt", "buck2_oc_evt", "buck2_ov_evt", "buck2_uv_evt", "ldo6_oc_evt", "ldo7_oc_evt", "ldo6_pgb_evt", "ldo7_pgb_evt";
+		pwr_off_seq = <0x4000202>;
+		phandle = <0xef>;
+
+		buck1 {
+			regulator-compatible = "BUCK1";
+			regulator-name = "VMDLA";
+			regulator-min-microvolt = <0x493e0>;
+			regulator-max-microvolt = <0x13d620>;
+			regulator-always-on;
+		};
+
+		buck2 {
+			regulator-compatible = "BUCK2";
+			regulator-name = "VDRAM1";
+			regulator-min-microvolt = <0x493e0>;
+			regulator-max-microvolt = <0x13d620>;
+			regulator-always-on;
+		};
+
+		ldo6 {
+			regulator-compatible = "LDO6";
+			regulator-name = "VMDDR";
+			regulator-min-microvolt = <0x7a120>;
+			regulator-max-microvolt = <0x200b20>;
+		};
+
+		ldo7 {
+			regulator-compatible = "LDO7";
+			regulator-name = "VDRAM2";
+			regulator-min-microvolt = <0x7a120>;
+			regulator-max-microvolt = <0x200b20>;
+			regulator-always-on;
+		};
+	};
+	mt6360_ldo: mt6360_ldo_dts {
+		status = "ok";
+		interrupt-parent = <&mt6360_pmu>;
+		interrupts = <0x71 0x00 0x72 0x00 0x73 0x00 0x75 0x00 0x79 0x00 0x7a 0x00 0x7b 0x00 0x7d 0x00>;
+		interrupt-names = "ldo1_oc_evt", "ldo2_oc_evt", "ldo3_oc_evt", "ldo5_oc_evt", "ldo1_pgb_evt", "ldo2_pgb_evt", "ldo3_pgb_evt", "ldo5_pgb_evt";
+		phandle = <0xf0>;
+
+		mt_pmic_vmc_ldo_reg: ldo1 {
+			regulator-compatible = "LDO1";
+			regulator-name = "VFP";
+			regulator-min-microvolt = <0x124f80>;
+			regulator-max-microvolt = <0x36ee80>;
+			regulator-always-on;
+			phandle = <0x1e5>;
+		};
+
+		mt_pmic_vtp_ldo_reg: ldo2 {
+			regulator-compatible = "LDO2";
+			regulator-name = "vtp";
+			regulator-min-microvolt = <0x124f80>;
+			regulator-max-microvolt = <0x36ee80>;
+			phandle = <0xf1>;
+			regulator-always-on;
+			status = "okay";
+		};
+
+		mt_pmic_vfp_ldo_reg: ldo3 {
+			regulator-compatible = "LDO3";
+			regulator-name = "VMC";
+			regulator-min-microvolt = <0x124f80>;
+			regulator-max-microvolt = <0x36ee80>;
+			phandle = <0x260>;
+		};
+
+		mt_pmic_vmch_ldo_reg: ldo5 {
+			regulator-compatible = "LDO5";
+			regulator-name = "VMCH";
+			regulator-min-microvolt = <0x2932e0>;
+			regulator-max-microvolt = <0x36ee80>;
+			phandle = <0x51>;
+		};
+	};
